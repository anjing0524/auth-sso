{
  "name": "@auth-sso/portal",
  "version": "1.1.2",
  "private": true,
  "description": "Auth-SSO 管理门户",
  "scripts": {
    "dev": "next dev -p 4100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "NODE_OPTIONS='--require ./scripts/preload-mock.cjs' node --import tsx scripts/seed.ts",
    "db:seed:e2e": "NODE_OPTIONS='--require ./scripts/preload-mock.cjs' node --import tsx scripts/seed-e2e.ts",
    "db:maintain-partitions": "npx tsx scripts/maintain-access-log-partitions.ts",
    "db:seed:demo": "NODE_OPTIONS='--require ./scripts/preload-mock.cjs' node --import tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@auth-sso/config": "workspace:*",
    "@auth-sso/contracts": "workspace:*",
    "@base-ui/react": "^1.5.0",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.2.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "pino": "^10.3.1",
    "postgres": "^4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.4",
    "jsdom": "^30.1.3",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
