# ============================================
# Auth-SSO Portal — 本地开发模板
# ============================================
# 使用：cp .env.example .env.local
# ============================================

NODE_ENV=development
LOG_LEVEL=info

NEXT_PUBLIC_APP_URL=http://localhost:4100

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_sso
REDIS_URL=redis://localhost:6379

PORTAL_CLIENT_SECRET=portal-secret

# 安全策略可选覆盖（不设置则使用默认值）
# SIGNATURE_TIMESTAMP_WINDOW_SEC=60  # HMAC 签名时间戳容忍窗口（秒）
# BRUTE_FORCE_MAX_ATTEMPTS=5      # 暴力破解锁定阈值（失败次数）
# BRUTE_FORCE_WINDOW_MINUTES=15   # 账户×IP 维度锁定窗口（分钟）
# BRUTE_FORCE_IP_MAX_ATTEMPTS=20 # 单个 IP 跨账户失败上限（ADR-025，超出返回 429）
# BRUTE_FORCE_IP_WINDOW_MINUTES=15 # IP 维度窗口（分钟）
# GATEWAY_SHARED_SECRET=          # Gateway-Portal HMAC 信任路径共享密钥（生产必须设置）
# COOKIE_SECURE=true              # 强制 Cookie Secure 标志（HTTPS 环境）
# PORTAL_JWKS_URI=                # 覆盖 JWKS 端点 URL（默认自动拼接）
# PORTAL_ISSUER=                  # 覆盖 issuer（必须与 discovery 取 metadata 的 URL 同源；默认取 NEXT_PUBLIC_APP_URL）
# TRUSTED_ORIGINS=                # 额外受信任来源（逗号分隔），用于跨域/代理场景
