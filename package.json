{
  "name": "auth-sso",
  "version": "1.1.1.1",
  "private": true,
  "description": "小企业统一门户 + SSO + 权限中心",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "./scripts/local/dev.sh",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "./scripts/e2e/release.sh",
    "deploy": "./scripts/docker/deploy.sh",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary && node scripts/ci/coverage-gate.mjs",
    "test:visual": "E2E_VISUAL=1 pnpm test:e2e",
    "test:a11y": "node scripts/ux/a11y.mjs"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.0"
  }
}
