{
  "name": "auth-sso",
  "version": "1.1.2",
  "private": true,
  "description": "小企业统一门户 + SSO + 权限中心",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "./scripts/local/dev.sh",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "./scripts/e2e/release.sh",
    "deploy": "./scripts/docker/deploy.sh",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary && node scripts/ci/coverage-gate.mjs",
    "test:visual": "E2E_VISUAL=1 pnpm test:e2e",
    "test:a11y": "node scripts/ux/a11y.mjs",
    "test:mutation": "stryker run stryker.config.json; rc=$?; rm -rf .stryker-tmp; exit $rc",
    "test:api": "vitest run --project @auth-sso/portal-api",
    "test:ui": "vitest run --project @auth-sso/portal-ui",
    "test:contracts": "vitest run --project @auth-sso/contracts",
    "test:ai": "./scripts/e2e-ai/run.sh"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@midscene/web": "1.17.6",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.22.4",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
