{
  "name": "auth-sso",
  "version": "1.1.1.1",
  "private": true,
  "description": "小企业统一门户 + SSO + 权限中心",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "./scripts/local/dev.sh",
    "dev:infra": "./scripts/local/infra.sh up",
    "dev:reset": "./scripts/local/reset.sh",
    "deploy:check": "./scripts/docker/deploy.sh --check",
    "deploy:up": "./scripts/docker/deploy.sh",
    "deploy:status": "./scripts/docker/deploy.sh --status",
    "deploy:rollback": "./scripts/docker/deploy.sh --rollback",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @auth-sso/portal db:migrate",
    "db:seed": "pnpm --filter @auth-sso/portal db:seed",
    "db:seed:e2e": "pnpm --filter @auth-sso/portal db:seed:e2e",
    "test": "vitest run",
    "test:api": "vitest run --project @auth-sso/portal-api",
    "test:components": "vitest run --project @auth-sso/portal-ui",
    "test:e2e": "./scripts/e2e/release.sh",
    "test:e2e:acme": "./scripts/e2e/acme-e2e.sh",
    "test:e2e:acme:staging": "./scripts/e2e/acme-staging.sh",
    "test:e2e:release": "playwright test tests/e2e/docker-release.spec.ts",
    "test:report": "node tests/traceability/generate-report.mjs",
    "stack:up": "./scripts/docker/stack.sh up",
    "stack:build": "./scripts/docker/stack.sh build",
    "stack:status": "./scripts/docker/stack.sh status",
    "stack:down": "./scripts/docker/stack.sh down",
    "stack:logs": "./scripts/docker/stack.sh logs"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "tsx": "^4.22.4",
    "wait-on": "^8.0.0",
    "vitest": "^4.1.9"
  }
}
