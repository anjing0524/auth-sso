# ============================================
# Auth-SSO — 统一环境变量模板
# ============================================
# 使用：cp .env.example .env.local 然后按需修改
# ============================================

# --- 运行环境 ---
NODE_ENV=development
LOG_LEVEL=info

# --- 应用基础配置 ---
NEXT_PUBLIC_APP_URL=http://localhost:4100
NEXT_PUBLIC_APP_NAME=Auth-SSO Portal
# Portal 进程监听端口（Docker 内为 4000）
PORT=4100

# --- 数据库 ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_sso_portal

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- OAuth 2.1 / OIDC ---
# Portal 自身作为 OIDC Provider 的内置客户端密钥
PORTAL_CLIENT_SECRET=portal-secret
# OIDC Issuer（不设置则自动推导为 NEXT_PUBLIC_APP_URL）
# PORTAL_ISSUER=https://sso.example.com
# 内部回调 URL（Gateway → Portal 令牌交换用，生产环境必须设置）
# PORTAL_INTERNAL_URL=http://portal:4100

# --- Gateway 信任路径 HMAC ---
# Gateway 上游转发时用此密钥对 (timestamp + userId + jti) 计算 HMAC-SHA256 签名。
# 生产环境必须配置；本地开发可留空（跳过 HMAC 校验）。
GATEWAY_SHARED_SECRET=

# --- Let's Encrypt（生产环境）---
# 公网 DNS 必须已解析到 Gateway，且入站 80/443 端口可达。
# LETSENCRYPT_DOMAIN=sso.example.com
# LETSENCRYPT_EMAIL=ops@example.com
# docker-compose.prod.yml 已固定该路径；非 Compose 部署可显式覆盖。
# ACME_STATE_DIR=/var/lib/gateway/acme
# ACME_CHECK_INTERVAL_SECS=21600
# ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# 公网 staging 演练专用；由 pnpm test:e2e:acme:staging 读取，不进入生产 Compose。
# LETSENCRYPT_STAGING_DOMAIN=staging-sso.example.com
# LETSENCRYPT_STAGING_EMAIL=ops@example.com
# 仅在真实公网 DNS 已生效且入站 80/443 已放通后设为 true。
# ACME_STAGING_PUBLIC_REACHABLE=true

# --- CORS ---
# 生产环境用逗号分隔的受信任来源域列表
# TRUSTED_ORIGINS=https://app1.example.com,https://app2.example.com
